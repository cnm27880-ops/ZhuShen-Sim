{
  // 主神空間打工日記：Cloudflare Workers 設定。
  // 靜態網站（遊戲前端）＋ /api/* 後端（worker/）＋ D1 資料庫。
  // 這裡不放任何密鑰。GOOGLE_CLIENT_SECRET 只能在 Cloudflare 後台以「密鑰 (Secret)」類型填寫。
  "name": "zhushen-sim",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // 保留在 Cloudflare 後台設定的變數（GOOGLE_CLIENT_ID、PUBLIC_ORIGIN）；沒有這行，每次部署都會把後台的變數洗掉。密鑰本來就不會被洗掉。
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // 只有 /api/ 底下的請求才交給後端程式，其他網址直接給靜態檔
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zhushen-sim",
      "database_id": "eccc71e7-a773-48bf-aa09-6aff7c610630"
    }
  ]
}
